# Copy this file to ".env" and fill in your own values.
# NEVER commit .env, and never paste real credentials into GitHub issues or screenshots.

# Google Gemini API key (https://aistudio.google.com/apikey).
# When set, this environment variable takes precedence over the DPAPI-encrypted local store.
GEMINI_API_KEY=

# Optional: override where J.A.V.E.D. keeps its private runtime data.
# Default on Windows: %LOCALAPPDATA%\JAVED
# JAVED_DATA_DIR=C:\Users\you\AppData\Local\JAVED

# Optional: DEBUG, INFO, WARNING, ERROR
# JAVED_LOG_LEVEL=INFO
