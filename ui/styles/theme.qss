/* J.A.V.E.D. — deep navy / cyan command interface
   Palette: #05070d background, #0a101c panels, #22d3ee accent, #3b82f6 blue. */

* {
    outline: 0;
}

QWidget {
    color: #dbe7f5;
    font-family: "Segoe UI";
    font-size: 13px;
}

QMainWindow, QWidget#Root, QWidget#MainColumn {
    background-color: #05070d;
}

QFrame#Sidebar {
    background-color: #060a12;
    border-right: 1px solid #101b2c;
}

QWidget#TopBar {
    background-color: #05070d;
    border-bottom: 1px solid #101b2c;
}

QWidget#PageStack {
    background-color: #05070d;
}

QWidget#Page, QWidget#PageContent {
    background-color: transparent;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ---------------------------------------------------------------- brand */
QLabel#BrandName {
    color: #f4faff;
    font-size: 19px;
    font-weight: 700;
}

QLabel#BrandSub {
    color: #5c7590;
    font-family: "Cascadia Mono";
    font-size: 8px;
}

QLabel#BrandMark {
    background-color: #08131f;
    border: 1px solid #16354a;
    border-radius: 10px;
}

QLabel#SidebarSection {
    color: #4b6079;
    font-family: "Cascadia Mono";
    font-size: 9px;
    font-weight: 600;
    padding: 12px 10px 4px 10px;
}

QLabel#SidebarFooter {
    color: #5c7590;
    font-family: "Cascadia Mono";
    font-size: 9px;
    padding-left: 2px;
}

QLabel#SidebarFooterMuted {
    color: #3e516a;
    font-family: "Cascadia Mono";
    font-size: 8px;
    padding-left: 2px;
    padding-top: 2px;
}

QFrame#Divider {
    background-color: #122033;
    border: none;
}

QFrame#VerticalDivider {
    background-color: #16243a;
    border: none;
}

/* --------------------------------------------------------------- nav */
QPushButton#NavButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #8497b0;
    font-size: 13px;
    padding: 8px 10px;
    text-align: left;
}

QPushButton#NavButton:hover {
    background-color: #0a1421;
    color: #dcecff;
}

QPushButton#NavButton[active="true"] {
    background-color: #0a1c29;
    border: 1px solid #123b4b;
    color: #67e8f9;
    font-weight: 600;
}

QLabel#PhaseBadge {
    background-color: #0a111b;
    border: 1px solid #16243a;
    border-radius: 7px;
    color: #5b6d84;
    font-family: "Cascadia Mono";
    font-size: 8px;
    min-width: 16px;
    padding: 2px 5px;
}

QLabel#PhaseBadge[active="true"] {
    background-color: #08222b;
    border-color: #155e75;
    color: #22d3ee;
}

QLabel#PhaseBadge[phase="LIVE"][active="true"] {
    background-color: #07251d;
    border-color: #145c46;
    color: #34d399;
}

/* --------------------------------------------------------------- topbar */
QLabel#TopBarTitle {
    color: #5c7590;
    font-family: "Cascadia Mono";
    font-size: 10px;
}

QLabel#Clock {
    color: #dcecff;
    font-family: "Cascadia Mono";
    font-size: 14px;
    font-weight: 600;
}

QLabel#ClockDate {
    color: #5c7590;
    font-family: "Cascadia Mono";
    font-size: 8px;
}

/* ---------------------------------------------------------------- pages */
QLabel#Eyebrow {
    color: #22d3ee;
    font-family: "Cascadia Mono";
    font-size: 9px;
    font-weight: 600;
}

QLabel#PageTitle {
    color: #f4faff;
    font-size: 25px;
    font-weight: 650;
}

QLabel#PageSubtitle {
    color: #8497b0;
    font-size: 12px;
}

QLabel#Display {
    color: #f4faff;
    font-size: 25px;
    font-weight: 650;
}

QLabel#BodyCopy {
    color: #a8bacf;
    font-size: 12.5px;
}

QLabel#Footnote {
    color: #5c6c84;
    font-size: 10.5px;
}

QLabel#MetaLine {
    color: #5c7590;
    font-family: "Cascadia Mono";
    font-size: 9.5px;
}

/* ---------------------------------------------------------------- cards */
QFrame#Card {
    background-color: #0a101c;
    border: 1px solid #142238;
    border-radius: 14px;
}

QFrame#HeroCard {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #081624,
        stop: 0.55 #0a101c,
        stop: 1 #0c1526
    );
    border: 1px solid #183248;
    border-radius: 16px;
}

QLabel#CardTitle {
    color: #eaf4ff;
    font-size: 13.5px;
    font-weight: 600;
}

QLabel#CardSubtitle {
    color: #6f829a;
    font-size: 10.5px;
}

/* -------------------------------------------------------------- tiles */
QLabel#TileTitle {
    color: #5c7590;
    font-family: "Cascadia Mono";
    font-size: 9px;
    font-weight: 600;
}

QLabel#TileValue {
    color: #f4faff;
    font-size: 27px;
    font-weight: 650;
}

QLabel#TileUnit {
    color: #6f829a;
    font-size: 11px;
    padding-bottom: 4px;
}

QLabel#TileDetail {
    color: #6f829a;
    font-size: 10px;
}

QProgressBar#MetricBar {
    background-color: #0e1a29;
    border: none;
    border-radius: 2px;
}

QProgressBar#MetricBar::chunk {
    background-color: #22d3ee;
    border-radius: 2px;
}

QProgressBar#MetricBar[severity="warning"]::chunk {
    background-color: #fbbf24;
}

QProgressBar#MetricBar[severity="error"]::chunk {
    background-color: #f87171;
}

QLabel#ChartValue {
    color: #cfe9f6;
    font-family: "Cascadia Mono";
    font-size: 12px;
}

/* ------------------------------------------------------------ readiness */
QLabel#ReadinessName {
    color: #c6d6e8;
    font-size: 12px;
    font-weight: 500;
}

QLabel#ReadinessDetail {
    color: #64788f;
    font-size: 10px;
}

QLabel#KeyLabel {
    color: #6f829a;
    font-size: 11px;
}

QLabel#ValueLabel {
    color: #c6d6e8;
    font-size: 11.5px;
}

QLabel#MonoValue {
    color: #9fb4ca;
    font-family: "Cascadia Mono";
    font-size: 10.5px;
}

QLabel#MonoMuted {
    color: #5c7590;
    font-family: "Cascadia Mono";
    font-size: 9px;
}

QLabel#FieldLabel {
    color: #a8bacf;
    font-size: 12px;
    font-weight: 500;
}

QLabel#FieldHint {
    color: #5c6c84;
    font-size: 10px;
}

/* ------------------------------------------------------------ status */
QLabel#StatusPill {
    border-radius: 9px;
    font-family: "Cascadia Mono";
    font-size: 8px;
    font-weight: 600;
    padding: 3px 8px;
}

QLabel#StatusPill[tone="ok"] {
    background-color: rgba(52, 211, 153, 0.10);
    border: 1px solid rgba(52, 211, 153, 0.32);
    color: #6ee7b7;
}

QLabel#StatusPill[tone="warning"] {
    background-color: rgba(251, 191, 36, 0.09);
    border: 1px solid rgba(251, 191, 36, 0.30);
    color: #fcd34d;
}

QLabel#StatusPill[tone="error"] {
    background-color: rgba(248, 113, 113, 0.09);
    border: 1px solid rgba(248, 113, 113, 0.32);
    color: #fca5a5;
}

QLabel#StatusPill[tone="accent"] {
    background-color: rgba(34, 211, 238, 0.09);
    border: 1px solid rgba(34, 211, 238, 0.28);
    color: #67e8f9;
}

QLabel#StatusPill[tone="muted"] {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid #1a2a3f;
    color: #6f829a;
}

/* --------------------------------------------------------- activity feed */
QLabel#ActivityTitle {
    color: #c6d6e8;
    font-size: 11.5px;
}

QLabel#ActivityDetail {
    color: #5c7590;
    font-size: 9.5px;
}

QLabel#ActivityDot {
    font-size: 8px;
}

/* --------------------------------------------------------- visualizer */
QLabel#VisualizerCaption {
    color: #5c7590;
    font-family: "Cascadia Mono";
    font-size: 9px;
}

QLabel#VisualizerState {
    color: #22d3ee;
    font-family: "Cascadia Mono";
    font-size: 8px;
}

/* ----------------------------------------------------------- banners */
QFrame#WarningBanner {
    background-color: rgba(251, 191, 36, 0.07);
    border-bottom: 1px solid rgba(251, 191, 36, 0.22);
}

QLabel#BannerText {
    color: #fcd34d;
    font-family: "Cascadia Mono";
    font-size: 9px;
}

/* ----------------------------------------------------------- buttons */
QPushButton {
    background-color: #0d1624;
    border: 1px solid #1b2b44;
    border-radius: 8px;
    color: #dcecff;
    font-size: 12px;
    font-weight: 500;
    padding: 7px 14px;
}

QPushButton:hover {
    background-color: #122033;
    border-color: #27425f;
}

QPushButton:pressed {
    background-color: #09111c;
}

QPushButton:disabled {
    background-color: #0a111b;
    border-color: #13202f;
    color: #4a5a70;
}

QPushButton[variant="primary"] {
    background-color: #22d3ee;
    border: 1px solid #22d3ee;
    color: #04141b;
    font-weight: 700;
}

QPushButton[variant="primary"]:hover {
    background-color: #67e8f9;
    border-color: #67e8f9;
}

QPushButton[variant="primary"]:disabled {
    background-color: #0d3a43;
    border-color: #0d3a43;
    color: #5c8d94;
}

QPushButton[variant="danger"] {
    background-color: rgba(248, 113, 113, 0.07);
    border: 1px solid rgba(248, 113, 113, 0.28);
    color: #fca5a5;
}

QPushButton[variant="danger"]:hover {
    background-color: rgba(248, 113, 113, 0.14);
}

QPushButton#StopButton {
    background-color: #140c12;
    border: 1px solid #3a1b22;
    border-radius: 8px;
    color: #6e3a44;
    font-family: "Cascadia Mono";
    font-size: 10px;
    font-weight: 600;
    padding: 9px;
}

QPushButton#StopButton:disabled {
    color: #5c3038;
    border-color: #2a161c;
}

/* ------------------------------------------------------------ inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QListWidget, QTextEdit {
    background-color: #070d17;
    border: 1px solid #16243a;
    border-radius: 8px;
    color: #e6f1ff;
    padding: 7px 10px;
    selection-background-color: #155e75;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QListWidget:focus, QTextEdit:focus {
    border-color: #22d3ee;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QComboBox:disabled, QCheckBox:disabled {
    color: #4a5a70;
}

QLineEdit::placeholder {
    color: #4a5a70;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #0a101c;
    border: 1px solid #1b2b44;
    color: #e6f1ff;
    selection-background-color: #0e2a36;
    selection-color: #e6f1ff;
    padding: 4px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #0d1624;
    border-left: 1px solid #16243a;
    width: 18px;
}

QCheckBox {
    color: #a8bacf;
    spacing: 9px;
}

QCheckBox::indicator {
    background-color: #070d17;
    border: 1px solid #24364f;
    border-radius: 4px;
    height: 16px;
    width: 16px;
}

QCheckBox::indicator:hover {
    border-color: #22d3ee;
}

QCheckBox::indicator:checked {
    background-color: #22d3ee;
    border-color: #22d3ee;
}

QCheckBox::indicator:disabled {
    background-color: #0a111b;
    border-color: #16202e;
}

/* ------------------------------------------------------------- tables */
QTableWidget {
    alternate-background-color: #0a1220;
    background-color: #070d17;
    border: 1px solid #142238;
    border-radius: 10px;
    color: #c6d6e8;
    gridline-color: #101c2d;
    selection-background-color: #0d2634;
    selection-color: #e6f1ff;
}

QTableWidget::item {
    padding: 5px 7px;
    border: none;
}

QHeaderView::section {
    background-color: #0a111c;
    border: none;
    border-bottom: 1px solid #16243a;
    color: #6f829a;
    font-family: "Cascadia Mono";
    font-size: 9px;
    padding: 7px 7px;
}

QTableCornerButton::section {
    background-color: #0a111c;
    border: none;
}

/* ------------------------------------------------------------ scrolling */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #1b2b44;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2a4565;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #1b2b44;
    border-radius: 4px;
    min-width: 30px;
}

/* ---------------------------------------------------------- conversation */
QFrame#ChatPanel {
    background-color: #080d17;
    border: 1px solid #142238;
    border-radius: 14px;
}

QWidget#ChatTranscript, QWidget#ChatTranscriptInner {
    background: transparent;
}

QFrame#ChatComposerFrame {
    background-color: #070c15;
    border-top: 1px solid #101b2c;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

QPlainTextEdit#ChatComposer {
    background-color: #070d17;
    border: 1px solid #16243a;
    border-radius: 10px;
    color: #e6f1ff;
    font-size: 12.5px;
    padding: 9px 11px;
    selection-background-color: #155e75;
}

QPlainTextEdit#ChatComposer:focus {
    border-color: #22d3ee;
}

QFrame#MessageBubble {
    background-color: #0a101c;
    border: 1px solid #16243a;
    border-radius: 12px;
}

QFrame#MessageBubble[role="assistant"] {
    background-color: #0a111d;
    border: 1px solid #17283f;
}

QFrame#MessageBubble[role="user"] {
    background-color: #0a2230;
    border: 1px solid #144a5d;
}

QFrame#MessageBubble[role="system"] {
    background-color: rgba(248, 113, 113, 0.05);
    border: 1px solid rgba(248, 113, 113, 0.28);
}

QFrame#MessageBubble[state="streaming"] {
    border-color: #156b80;
}

QFrame#MessageBubble[state="error"] {
    border-color: rgba(248, 113, 113, 0.50);
}

QFrame#MessageBubble[state="cancelled"] {
    border-color: rgba(251, 191, 36, 0.34);
}

QLabel#BubbleRole {
    color: #67e8f9;
    font-family: "Cascadia Mono";
    font-size: 8px;
    font-weight: 600;
}

QLabel#BubbleMeta {
    color: #4f647c;
    font-family: "Cascadia Mono";
    font-size: 8px;
}

QLabel#BubbleBody {
    color: #d6e5f5;
    font-size: 12.5px;
}

QListWidget#HistoryList {
    background-color: #070d17;
    border: 1px solid #142238;
    border-radius: 10px;
    padding: 4px;
}

QListWidget#HistoryList::item {
    border-bottom: 1px solid #101b2c;
    border-radius: 6px;
    color: #a8bacf;
    padding: 8px 8px;
}

QListWidget#HistoryList::item:hover {
    background-color: #0c1828;
    color: #dcecff;
}

QListWidget#HistoryList::item:selected {
    background-color: #0a2230;
    color: #a5f3fc;
}

/* --------------------------------------------------------------- misc */
QLabel#EmptyState {
    color: #5c6c84;
    font-size: 11px;
    padding: 10px 2px;
}

QLabel#Bullet {
    color: #b7c8dc;
    font-size: 11.5px;
    padding: 2px 0;
}

QLabel#BulletMuted {
    color: #7d90a7;
    font-size: 11px;
    padding: 2px 0;
}

QLabel#PhaseGhost {
    color: rgba(34, 211, 238, 0.12);
    font-family: "Cascadia Mono";
    font-size: 64px;
    font-weight: 700;
    padding-right: 4px;
}

QToolTip {
    background-color: #0d1624;
    border: 1px solid #1b2b44;
    color: #dcecff;
    padding: 5px 8px;
}

QMessageBox {
    background-color: #0a101c;
}

QMessageBox QLabel {
    color: #dbe7f5;
}

QFileDialog {
    background-color: #0a101c;
}

QMenu {
    background-color: #0a101c;
    border: 1px solid #1b2b44;
    color: #dcecff;
}

QMenu::item:selected {
    background-color: #0e2a36;
}
